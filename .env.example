# ══════════════════════════════════════════════
# wetty-mcp-terminal 环境变量配置
#
# 使用方法：
#   cp .env.example .env
#   按需修改下方配置项
#
# .env 文件已在 .gitignore 中，不会被提交到仓库
# ══════════════════════════════════════════════

# ── 数据库配置 ──────────────────────────────────
# 设置 DATABASE_URL → MySQL 模式
# 留空或注释掉 → SQLite 模式（默认，零配置）
#
# 远程 MySQL 示例：
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/wetty_terminal?charset=utf8mb4
#
# 本地 MySQL 容器（需配合 docker-compose.override.yml）：
# DATABASE_URL=mysql+aiomysql://wetty:wetty123@mysql:3306/wetty_terminal?charset=utf8mb4
DATABASE_URL=

# ── 本地 MySQL 容器配置（仅使用 override 时需要）──
# MYSQL_ROOT_PASSWORD=root123
# MYSQL_DATABASE=wetty_terminal
# MYSQL_USER=wetty
# MYSQL_PASSWORD=wetty123

# ── 应用配置 ──────────────────────────────────
# API Token（设置后 MCP 客户端连接时需要此 Token，留空则自动生成）
WETTY_API_TOKEN=

# ── 加密密钥（重要！）─────────────────────────
# 用于加密存储 SSH 密码和凭据，必须设置固定值，否则每次重启后已加密密码无法解密
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WETTY_ENCRYPTION_KEY=

# ── YAML 同步配置 ─────────────────────────────
# 首次初始化模式（默认行为）：
#   - 数据库为空时自动从 hosts.yaml 导入种子数据
#   - 数据库已有数据时跳过自动同步，避免覆盖页面编辑内容
#   - 手动同步 API (POST /api/hosts/sync) 始终可用
#
# 文件监听模式（设置为 true 启用）：
#   - 检测到 hosts.yaml 变更时自动强制同步到数据库
#   - 适用于以 YAML 文件为主要管理方式的场景
WETTY_WATCH_YAML=
